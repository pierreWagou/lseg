# Copy to `.env` and fill in. Never commit `.env`.
# Session selection: desktop | platform-ldpv2 | auto (default)
LSEG_SESSION=auto
# Desktop (Workspace/Eikon) — only the AppKey is required. Workspace app must be running.
LSEG_APP_KEY=
# Platform LDP v2 (headless OAuth2 client credentials) — all three required.
# LSEG_APP_KEY= (same var as above, reuse your V2 app key here)
LSEG_CLIENT_ID=
LSEG_CLIENT_SECRET=
LSEG_TOKEN_SCOPE=trapi
# Optional: lseg-data log level (debug, info, warning, error, critical)
LD_LIB_LOG_LEVEL=warning
